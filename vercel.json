{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(img|video|downloads)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/assets/downloads/(.*)", "headers": [ { "key": "Content-Disposition", "value": "attachment" } ] }
  ]
}
